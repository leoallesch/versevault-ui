<!-- C03 · ClockDisplay
     HH:MM AM/PM — present on every screen via ContentPanelBody.

     blink param:   "off" = idle (88px, full opacity)
                    "on"  = edit/firing (82px, opacity toggles 1.0↔0.25 at 500ms via lv_anim in C)

     The C presenter writes clock_time ("10:42") and clock_ampm ("AM"/"PM") to subjects.
     Blink animation is driven by a 500ms lv_anim on the root lv_obj's opa — started/stopped by C
     when clock_blink subject changes. -->

<component>
    <styles>
        <!-- Idle clock digits — 88px, tight tracking -->
        <style name="digits_idle"
               text_color="0x1AFF8C"
               text_font="orbitron_88"
               text_letter_space="-3"/>

        <!-- Edit / firing clock digits — 82px -->
        <style name="digits_edit"
               text_color="0x1AFF8C"
               text_font="orbitron_82"
               text_letter_space="-3"/>

        <!-- Colon — dimmer green -->
        <style name="colon"
               text_color="0x0E6A3A"
               text_font="orbitron_88"
               text_letter_space="-3"/>

        <!-- AM/PM superscript -->
        <style name="ampm"
               text_color="0x0E8A4A"
               text_font="orbitron_17"/>
    </styles>

    <!-- Root container — C drives opacity for blink; centers content -->
    <view extends="lv_obj"
          name="clock_root"
          width="content" height="content"
          style_bg_opa="0"
          style_border_width="0"
          style_layout="flex"
          style_flex_flow="row"
          style_flex_cross_place="center"
          style_pad_all="0"
          scrollable="false">

        <!-- Hour + colon + minute in a tight row -->
        <lv_label name="clock_digits"
                  text=""
                  style_text_color="0x1AFF8C"
                  style_text_font="orbitron_88"
                  style_text_letter_space="-3"/>

        <!-- AM/PM — vertically aligned to top (superscript effect via margin) -->
        <lv_label name="clock_ampm"
                  text=""
                  style_text_color="0x0E8A4A"
                  style_text_font="orbitron_17"
                  style_margin_left="5"
                  align="top_left"
                  y="0"/>

    </view>
</component>
