<!-- C06 · StatusStrip
     Weather + now-playing, always in BottomBar.
     480×26px, 0.5px borders top/bottom (#111A14), vertical divider (#1A2A20, 13px).

     weather_text subject: '☀ 72°F Clear'
     track_text subject:   '♫ Redbone · Childish Gambino ‖'
     C truncates with … if track/artist exceeds ~140px at 11px font. -->

<component>
    <styles>
        <!-- Strip container -->
        <style name="strip"
               bg_color="0x0A0C0F"
               bg_opa="255"
               border_width="1"
               border_color="0x111A14"
               border_side="top"
               radius="0"
               pad_top="0" pad_bottom="0"
               pad_left="12" pad_right="12"/>

        <!-- Weather text -->
        <style name="weather_lbl"
               text_color="0x1A7A4A"
               text_font="mono_11"
               text_align="left"/>

        <!-- Track text -->
        <style name="track_lbl"
               text_color="0x1AFF8C"
               text_font="mono_11"
               text_align="right"/>

        <!-- Vertical divider -->
        <style name="divider"
               bg_color="0x1A2A20"
               bg_opa="255"
               width="1" height="13"
               border_width="0"/>
    </styles>

    <!-- Root: full-width flex row, space-between, vertically centered -->
    <view extends="lv_obj"
          name="status_strip"
          width="480" height="28"
          align="center"
          style_layout="flex"
          style_flex_flow="row"
          style_flex_main_place="space_between"
          style_flex_cross_place="center"
          style_bg_color="0x0A0C0F"
          style_bg_opa="255"
          style_border_width="0"
          style_radius="0"
          style_pad_top="0" style_pad_bottom="0"
          style_pad_left="12" style_pad_right="12"
          scrollable="false">

        <!-- Weather — fixed half-width, left-justified -->
        <lv_label name="weather_label"
                  style_text_color="0x1A7A4A"
                  style_text_font="mono_11"
                  style_text_align="center"
                  width="219"
                  long_mode="dots"/>

        <!-- Vertical center divider -->
        <lv_obj name="strip_divider"
                width="2" height="100%"
                style_bg_color="0x1A2A20"
                style_bg_opa="255"
                style_border_width="0"
                style_radius="0"
                style_margin_left="8"
                style_margin_top="8"
                style_margin_bottom="8"
                style_margin_right="8"/>

        <!-- Track — fixed half-width, right-justified -->
        <lv_label name="track_label"
                  style_text_color="0x1AFF8C"
                  style_text_font="mono_11"
                  style_text_align="center"
                  width="219"
                  long_mode="dots"/>

    </view>
</component>
