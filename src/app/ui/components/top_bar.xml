<!-- C01 · TopBar
     Permanent header — 480×28px
     Children: DateLabel (flex:1 centered) · WiFiBadge · ModeBadge
     Mounted once on the root screen, never hidden. -->

<component>
    <!-- Root: full-width flex row, date centered · badges right -->
    <view extends="lv_obj"
          width="480" height="28"
          style_layout="flex"
          style_flex_flow="row"
          style_flex_main_place="space_between"
          style_flex_cross_place="center"
          style_bg_color="0x0A0C0F"
          style_bg_opa="255"
          style_border_width="0"
          style_radius="0"
          style_pad_left="22" style_pad_right="22"
          style_pad_top="6"   style_pad_bottom="0"
          scrollable="false">

        <!-- Left: WiFiBadge in 80px fixed section -->
        <lv_obj width="80" height="content"
                style_layout="flex"
                style_flex_flow="row"
                style_flex_cross_place="center"
                style_flex_main_place="center"
                style_bg_opa="0"
                style_border_width="0"
                style_pad_all="0">
            <wifi_badge name="wifi_indicator"/>
        </lv_obj>

        <!-- Center: DateLabel in 276px fixed section -->
        <lv_label name="date_label"
                  style_text_color="0x2A5040"
                  style_text_font="mono_11"
                  style_text_letter_space="2"
                  style_text_align="center"
                  width="276"/>

        <!-- Right: ModeBadge in 80px fixed section -->
        <lv_obj width="80" height="content"
                style_layout="flex"
                style_flex_flow="row"
                style_flex_cross_place="center"
                style_flex_main_place="end"
                style_bg_opa="0"
                style_border_width="0"
                style_pad_all="0">
            <mode_badge name="mode_badge"/>
        </lv_obj>

    </view>
</component>
