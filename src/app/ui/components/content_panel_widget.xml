<!-- C02c · ContentPanelWidget
     Optional slot — container for SET_AUTO_EDIT content.
     Hidden on all other screens via LV_OBJ_FLAG_HIDDEN (C presenter).
     Children are injected by the caller (idle.xml). -->

<component>
    <view extends="lv_obj"
          name="cp_widget"
          width="100%" height="content"
          style_layout="flex"
          style_flex_flow="column"
          style_flex_main_place="center"
          style_flex_cross_place="center"
          style_bg_opa="0"
          style_border_width="0"
          style_pad_top="6"    style_pad_bottom="4"
          style_pad_left="0"   style_pad_right="0"
          scrollable="false">
    </view>
</component>
