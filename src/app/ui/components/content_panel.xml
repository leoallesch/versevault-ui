<!-- C02 · ContentPanel
     flex:1 column container between TopBar and BottomBar.
     Children injected by caller. -->

<component>
    <view extends="lv_obj"
          name="content_panel"
          width="480" height="1"
          style_flex_grow="1"
          style_layout="flex"
          style_flex_flow="column"
          style_flex_main_place="start"
          style_flex_cross_place="center"
          style_bg_opa="0"
          style_border_width="0"
          style_pad_all="0"
          scrollable="false">
    </view>
</component>
